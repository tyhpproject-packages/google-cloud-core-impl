{
    "name": "tyhpdef/google-cloud-core-impl",
    "description": "Implementation package for tyhpdef/google-cloud-core. Require tyhpdef/google-cloud-core, not this package.",
    "keywords": [
        "dev",
        "static analysis",
        "internal"
    ],
    "type": "library",
    "license": "Apache-2.0",
    "version": "1.73.3.0",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {
        "tyhp": {
            "interopContractVersion": 1,
            "php-version": ">=8.2",
            "require": {
                "tyhpdef/php": "@dev",
                "tyhpdef/google-auth": "@dev",
                "tyhpdef/psr-http-message": "@dev",
                "tyhpdef/psr-cache": "@dev",
                "tyhpdef/psr-log": "@dev",
                "tyhpdef/guzzlehttp-guzzle": "@dev",
                "tyhpdef/guzzlehttp-promises": "@dev",
                "tyhpdef/monolog-monolog": "@dev"
            },
            "package": {
                "include": [
                    "./_tyhpdef/*.tyhpdef",
                    "./_tyhpdef/extensions/*.tyhpdef"
                ],
                "overlay": [
                    "./_tyhpdef/overlays/stubs/*.tyhpdef",
                    "./_tyhpdef/overlays/*.tyhpdef"
                ]
            },
            "public": "tyhpdef/google-cloud-core"
        }
    },
    "require": {
        "php": ">=8.2",
        "google/cloud-core": "1.73.3"
    },
    "require-dev": {
        "tyhpdef/php": "@dev",
        "tyhpdef/google-auth": "@dev",
        "tyhpdef/psr-http-message": "@dev",
        "tyhpdef/psr-cache": "@dev",
        "tyhpdef/psr-log": "@dev",
        "tyhpdef/guzzlehttp-guzzle": "@dev",
        "tyhpdef/guzzlehttp-promises": "@dev",
        "tyhpdef/monolog-monolog": "@dev"
    }
}
